# 1. Khóa Mã Hóa Bí Mật Chủ (KEK) - 32 bytes Base64
# Tạo bằng lệnh: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
KEK_V1=dGVzdF9rZWtfMzJfYnl0ZXNfYmFzZTY0X2tleV9mb3JfZGV2XzEyMzQ=

# 2. Khóa Bí Mật Ký JWT Xác thực Portal
JWT_SECRET=super_secret_jwt_key_for_zalo_baas_portal_production

# 3. Google Gemini API Key (Gemini 2.5 Flash & Text Embedding 004)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere1234567890

# 4. Webhook Base URL công khai (trỏ về Gateway Worker)
WEBHOOK_BASE_URL=https://bot.knm.asia/v1/webhook/bot

# 5. URL Backend API phục vụ Next.js Portal
NEXT_PUBLIC_API_URL=https://api.bot.knm.asia

# 6. Cloudflare Bindings (Cấu hình trên Cloudflare Dashboard hoặc wrangler.toml)
